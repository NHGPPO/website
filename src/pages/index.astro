---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Northern Health GPPO: supporting North Manchester's GP practices and patients" description="A not-for-profit membership organisation supporting North Manchester's 34 GP practices and the wider local health system.">
  <div class="k2top">
    <div class="wrap k2tg">
      <div>
        <div class="pline" aria-hidden="true"></div>
        <p class="dateline">North Manchester · GP federation</p>
        <h1>Supporting North Manchester's GP practices and patients</h1>
        <p class="lede">A not-for-profit membership organisation supporting North Manchester's 34 GP practices and the wider local health system.</p>
      </div>
    </div>
  </div>
  <div class="doors">
    <div class="door pat on-dark">
      <h2>For patients</h2>
      <div class="row">
        <span class="tile"><Icon name="stethoscope" /></span>
        <div><h3>Evening and weekend appointments</h3><p>GP, nurse and blood test appointments outside core hours. Book through your own practice.</p></div>
      </div>
      <div class="row">
        <span class="tile"><Icon name="info" /></span>
        <div><h3>Need medical help now?</h3><p>Call NHS 111, or 999 in an emergency.</p></div>
      </div>
      <a class="btn" href="/services/#service-provision">How booking works <Icon name="arrow-right" /></a>
    </div>
    <div class="door prac">
      <h2>For practices and partners</h2>
      <div class="row">
        <span class="tile"><Icon name="users" /></span>
        <div><h3>Primary Care Network support</h3><p class="muted">Workforce, finance, returns and governance support for our 34 member practices and their PCNs.</p></div>
      </div>
      <div class="row">
        <span class="tile"><Icon name="puzzle" /></span>
        <div><h3>Partnership working</h3><p class="muted">Working with partners across the health system for the best possible patient care.</p></div>
      </div>
      <a class="btn secondary" href="/services/#pcn-support">Practice support <Icon name="arrow-right" /></a>
    </div>
  </div>
  <section class="surface">
    <div class="wrap k2low">
      <div>
        <div class="pline" aria-hidden="true"></div>
        <p class="dateline">Since 2015</p>
        <h2>A track record of delivery</h2>
        <p class="lede" style="margin-top:14px">National and local contracts and high-profile pilot schemes, including Victoria Mill, Charlestown and Park View medical centres.</p>
        <p style="margin-top:24px"><a href="/about-us/">See all our contracts and pilot schemes</a></p>
      </div>
      <figure class="k2q">
        <div class="qm" aria-hidden="true">&#8220;</div>
        <blockquote>I was very impressed with the efficiency of the service.</blockquote>
        <figcaption>Patient feedback</figcaption>
      </figure>
    </div>
  </section>
</Base>
