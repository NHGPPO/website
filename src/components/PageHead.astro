---
interface Props { crumb: string; title: string; lede: string }
const { crumb, title, lede } = Astro.props;
---
<div class="phead">
  <div class="wrap">
    <div class="pline" aria-hidden="true"></div>
    <p class="crumb dateline"><a href="/">Home</a> <span aria-hidden="true">/</span> {crumb}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <slot />
  </div>
</div>
